# ── Required in production ─────────────────────────────────────────────
# Any Postgres. Neon/Supabase: use the pooled connection string.
# Leave empty locally to use the embedded PGlite database in .data/pglite.
DATABASE_URL=
# Signs admin sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Public URL, no trailing slash. Used for canonical links, sitemap and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── First admin (used once by `npm run db:seed` when no users exist) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ── Contact (optional) ─────────────────────────────────────────────────
# WhatsApp number in international format, digits only, e.g. 919800000000. Empty hides WhatsApp links.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# ── New-enquiry email alerts via Resend (optional) ─────────────────────
RESEND_API_KEY=
# Comma-separated list of team addresses
ENQUIRY_NOTIFY_EMAIL=
# Must be a verified sender domain in Resend
EMAIL_FROM=TripBuddy <hello@example.com>

# ── Tuning (optional) ──────────────────────────────────────────────────
DATABASE_POOL_SIZE=5
ENQUIRY_RETENTION_MONTHS=24
